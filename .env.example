# ==============================================================================
# English Phonetics & Vocal Laboratory - Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in your Gemini API key:
#   cp .env.example .env.local
#
# Get your free Gemini API key from Google AI Studio:
#   https://aistudio.google.com/apikey
# ==============================================================================

# Required: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Optional Model Configurations (Defaults will be used if omitted)
# ------------------------------------------------------------------------------

# Live Audio Telemetry Model (WebSocket)
# Options:
#   - gemini-3.1-flash-live-preview (Recommended: Ultra-fast ~0.9s response)
#   - gemini-3.8-live               (Deep reasoning capability)
#   - gemini-2.5-flash-native-audio-latest (Native audio model)
LIVE_MODEL=gemini-3.1-flash-live-preview

# Live Voice Persona
# Options: Puck, Charon, Kore, Fenrir, Aoede, Zephyr, Orion
LIVE_VOICE=Puck

# Text Generation Models (Curriculum generation & diagnostic feedback scoring)
# Comma-separated list with automatic fallback
TEXT_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-2.5-flash
