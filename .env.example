# ==============================================================================
# Sounds Like You - Environment Variables
# ==============================================================================
# Local: copy this file to .env.local and fill in your Gemini API key:
#   cp .env.example .env.local
# Hosted (Vercel): set the same names under Project -> Settings -> Environment
# Variables. See docs/DEPLOY.md.
#
# Get a Gemini API key from Google AI Studio:
#   https://aistudio.google.com/apikey
# ==============================================================================

# Required: Google Gemini API key (server-only; the browser never sees it)
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Public hosting: abuse and cost protection
# ------------------------------------------------------------------------------

# Set to 1 when the app runs behind a proxy that overwrites X-Forwarded-For (Vercel, a CDN or a
# load balancer), so each visitor gets their own rate limit. Leave unset locally: without a trusted
# proxy that header is client-controlled and ignored, and every caller shares one bucket.
# TRUST_PROXY=1

# Shared rate limits and daily budget (Upstash Redis, free tier is enough). Without these, limits are
# kept in memory per server instance: fine locally, useless across serverless instances.
# The Vercel Marketplace integration may add them as KV_REST_API_URL / KV_REST_API_TOKEN instead;
# either pair works.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Most costly AI calls the whole app may make per UTC day (Live coach/examiner tokens, model clips,
# shadowing coaching, interview feedback). Past it those routes answer 503 "AI service is busy"
# until midnight UTC. Default 2000.
# DAILY_AI_LIMIT=2000

# Extra origins allowed to call the API (comma-separated). Same-origin requests are always allowed.
# ALLOWED_ORIGINS=https://staging.example.com

# ------------------------------------------------------------------------------
# Optional model configuration (defaults are used if omitted)
# ------------------------------------------------------------------------------

# Live audio model (WebSocket) for the coach and the examiner
# Options:
#   - gemini-3.1-flash-live-preview (Recommended: ultra-fast ~0.9s response)
#   - gemini-3.8-live               (Deep reasoning capability)
#   - gemini-2.5-flash-native-audio-latest (Native audio model)
LIVE_MODEL=gemini-3.1-flash-live-preview

# Live voice persona
# Options: Puck, Charon, Kore, Fenrir, Aoede, Zephyr, Orion
LIVE_VOICE=Puck

# Text generation models (lessons, feedback, scripts). Comma-separated, tried in order.
TEXT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash

# Text-to-speech models for the shadowing model clips (tried in order)
TTS_MODELS=gemini-3.8-flash-tts,gemini-3.1-flash-tts-preview,gemini-3.8-flash-lite-tts

# Voice for the shadowing model clip
TTS_VOICE=Puck

# How model clips are voiced: "live" (default) uses the coach's Gemini Live voice, checked
# word-for-word against the script, with TTS as a fallback; "tts" uses the TTS models only.
# On Vercel Hobby (60 s function limit) use "tts": it is faster, cheaper and never times out.
# MODEL_AUDIO_ENGINE=tts
# Live model used to read model clips (defaults to LIVE_MODEL)
# LIVE_RENDER_MODEL=gemini-3.1-flash-live-preview
